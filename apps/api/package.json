{
  "name": "@split-expenses/api",
  "version": "1.0.0",
  "description": "REST API for groups, expenses, balances and settlements",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning ../../node_modules/jest/bin/jest.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "dotenv": "^18.0.10",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
